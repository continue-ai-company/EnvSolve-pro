{
  "paths": {
    "runs": "runs"
  },
  "benchmarks": {
    "envbench": {
      "adapter": "envbench",
      "root": "EnvBench",
      "settings": {
        "image": "ghcr.io/jetbrains-research/envbench-python:latest",
        "deterministic_script": "evaluation/scripts/python_baseline.sh"
      }
    }
  },
  "solvers": {
    "envbench-agent": {
      "root": "EnvBench"
    },
    "repo2run": {
      "root": "Repo2Run"
    }
  },
  "model_pricing": {
    "deepseek/deepseek-v4-pro": {
      "input_cost_per_million": 0.435,
      "output_cost_per_million": 0.87,
      "cache_read_cost_per_million": 0.003625,
      "source_url": "https://openrouter.ai/deepseek/deepseek-v4-pro",
      "snapshot_date": "2026-07-13"
    }
  },
  "generation": {
    "timeout": 7200,
    "model_request_timeout": 180,
    "model_max_retries": 2,
    "model_max_output_tokens": 32768,
    "model_reasoning_effort": "high",
    "model_response_format": "json_object",
    "model_max_requests": 15,
    "model_max_total_tokens": 1000000,
    "model_max_estimated_cost_usd": 5.0,
    "max_iterations": 15,
    "envsolve_max_candidates": 15,
    "envsolve_max_environments": 5,
    "envsolve_max_commands": 5,
    "bash_timeout": 900
  },
  "evaluation": {
    "create_container_timeout": 180,
    "container_timeout": 900,
    "process_timeout": 1800,
    "git_fetch_timeout": 300,
    "max_workers": 1
  }
}
